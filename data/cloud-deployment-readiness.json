{
  "schema_version": "xlooop.cloud_deployment_readiness.v2",
  "last_updated": "2026-08-14",
  "stage": "paired_production_controlled_validation",
  "canonical_public_domains": {
    "app": "https://app.xlooop.com",
    "api": "https://api.xlooop.com",
    "marketing": "https://www.xlooop.com"
  },
  "public_self_serve": {
    "status": "hold_pending_live_evidence",
    "required_before_go": [
      "ratified_exact_api_and_app_pair",
      "production_database_and_rls_authority",
      "api_mcp_live_canary",
      "production_delete_export_legal_hold_receipt",
      "two_company_24_48h_live_pilot"
    ]
  },
  "deployment_topology": {
    "kind": "paired_worker_api_and_rich_pages",
    "single_mutation_command": "deploy:paired:prod",
    "api_runtime": "cloudflare_workers",
    "app_runtime": "cloudflare_pages",
    "frontend_source_repo": "x-ai-front",
    "frontend_artifact_contract": "rich_ui_v3",
    "frontend_source_spec": "project/App.dc.html",
    "frontend_source_spec_class": "demo_derived_ux_spec",
    "frontend_production_source": "wired/src",
    "frontend_build_producer": "wired/scripts/build-mode.mjs",
    "frontend_build_output": "wired/dist-production",
    "production_deploy_allowed_from_spec": false,
    "backend_source_repo": "x-backend",
    "release_manifest": "dist-app-pages-release/release-manifest.json",
    "standalone_api_or_pages_production_deploy_allowed": false,
    "compensating_rollback_required": true
  },
  "github_actions": {
    "active": false,
    "reason": "GitHub-hosted checks are not release authority while runs can terminate before checkout and produce no application-step evidence.",
    "canonical_deploy": "local_operator_approved_paired_cutover",
    "active_workflow_directory_policy": ".github/workflows must contain no YAML workflows while unavailable or non-authoritative",
    "preserved_templates": "deployment/github-actions-disabled"
  },
  "required_local_gates": [
    "verify:github-actions-disabled",
    "verify:orchestrator-script-contracts",
    "verify:cloud-deployment-readiness",
    "verify:cloudflare-deployment-signal",
    "verify:deployed-surfaces",
    "verify:active-repository-dependencies",
    "verify:deploy-provenance",
    "verify:deploy-schema-head",
    "verify:frontend-pair:self-test",
    "verify:rollback-target-authority:self-test",
    "verify:app-pages-release:self-test",
    "deploy:paired:prod:self-test",
    "verify:hosted-deployment-evidence",
    "verify:hosted-ci-runner-health",
    "verify:api-mcp-live-canary-hard-stop",
    "verify:public-production-readiness-hard-stop"
  ],
  "surfaces": [
    {
      "surface_id": "api",
      "url": "https://api.xlooop.com",
      "runtime": "cloudflare_workers",
      "authority": "production",
      "source_repo": "x-backend",
      "deploy_script": "deploy:paired:prod",
      "ratification": "health tuple, schema head, contract hash, build SHA, keyring health"
    },
    {
      "surface_id": "app",
      "url": "https://app.xlooop.com",
      "runtime": "cloudflare_pages",
      "authority": "production",
      "source_repo": "x-ai-front",
      "source_spec": "project/App.dc.html",
      "production_deploy_allowed_from_spec": false,
      "production_source": "wired/src",
      "release_input_artifact": "wired/dist-production",
      "serving_artifact": "x-backend/dist-app-pages-release",
      "artifact_contract": "rich_ui_v3",
      "forbidden_deploy_sources": [
        "project/App.dc.html",
        "wired/src",
        "wired/index.html"
      ],
      "deploy_script": "deploy:paired:prod",
      "ratification": "release manifest, public hashes, backend tuple, security headers, authenticated journey"
    }
  ],
  "authority_contract": {
    "exact_operator_approval_required": true,
    "single_use_authorization_required": true,
    "maximum_authorization_minutes": 30,
    "candidate_tuple": [
      "backend_sha",
      "frontend_sha",
      "contract_hash",
      "schema_head",
      "feature_posture",
      "artifact_digest"
    ],
    "rollback_pair_must_be_preverified": true,
    "failed_ratification_triggers_compensating_rollback": true,
    "deployment_is_not_public_self_serve_authority": true
  }
}
